# IntelliFlood Web — local environment example
# -------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env
# 2. Edit `.env` with your own local values.
# 3. Never commit a real `.env` (see root `.gitignore`).
#
# Only VITE_* variables are exposed to the client bundle by design.
# All values below are safe local defaults.
# -------------------------------------------------------------

# Base URL of the backend API, used by the frontend to call the server.
# Leave this commented out to reuse the browser hostname (works for
# localhost, 127.0.0.1 and LAN addresses alike). Set it explicitly when the
# API lives on a different host.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# URL of the standalone IntelliFlood World application.
VITE_INTELLIFLOOD_WORLD_URL=http://127.0.0.1:4173

# Local development server port.
VITE_PORT=5173