# MasterEarth API — local environment example
# -------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env
# 2. Edit `.env` with your own local values.
# 3. Never commit a real `.env` (see root `.gitignore`).
#
# All values below are safe local defaults. No secrets, no keys, no
# passwords that would grant access to anything real.
# -------------------------------------------------------------

# Application
APP_NAME=MasterEarth API
API_VERSION=0.1.0
APP_ENV=development

# Server
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false

# CORS — allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL / PostGIS Database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=intelliflood
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intelliflood
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
# M2.2 — clé requise pour créer des capteurs et envoyer des mesures (à changer !)
INGEST_API_KEY=dev-key-change-me

# M3 — météo automatique (Open-Meteo : usage non commercial ; licence requise sinon)
WEATHER_ENABLED=true
WEATHER_REFRESH_MINUTES=30
WEATHER_OPENWEATHER_API_KEY=

# M11 — health monitoring: provisional until field sensor cadence is known
SENSOR_STALE_MINUTES=60

# M2.3 — comptes. Générer un secret : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Premier administrateur (créé au démarrage si aucun compte n'existe ; retirer le mot de passe ensuite)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Moteur IA (facultatif, mode local disponible sans clé IA)
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Clé obligatoire pour enregistrer les clés fournisseurs; conserver une sauvegarde séparée et sécurisée.
AI_ENCRYPTION_KEY= HDCGbCVLVSMkpvv8YAr3j5fbjlxufcPM4ygNLRRDxKk=
AI_REQUEST_TIMEOUT_SECONDS=12
