# IntelliFlood — Exemple de configuration globale locale (M0.2/M1)
# -----------------------------------------------------------------
# 1. Copier ce fichier : cp .env.example .env (ou configurer par application)
# 2. Ajuster les valeurs selon votre environnement de développement local.
# 3. Ne JAMAIS committer un fichier .env contenant des secrets réels.
#
# Toutes les valeurs ci-dessous sont des valeurs locales sûres par défaut.
# Aucun secret, aucun token ni aucune clé de production n'est présent.
# -----------------------------------------------------------------

# Application & Environnement d'exécution
APP_NAME=IntelliFlood API
API_VERSION=0.1.0
APP_ENV=development

# Backend FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_PORT=5173

# PostgreSQL / PostGIS Database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=intelliflood
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intelliflood
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# M2.2 : clé requise pour les écritures API (à changer)
INGEST_API_KEY=dev-key-change-me

# Docker Compose (profil full)
INGEST_API_KEY=dev-key-change-me
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEATHER_ENABLED=false
SENSOR_STALE_MINUTES=60
